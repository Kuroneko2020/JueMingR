<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <PlatformTarget>x86</PlatformTarget>
    <OutputType>Exe</OutputType>
    <AssemblyName>Terraria</AssemblyName>
    <RootNamespace>Terraria</RootNamespace>
    <AssemblyVersion>1.4.5.8</AssemblyVersion>
    <FileVersion>1.4.5.8</FileVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The fixed game uses optimized branch predicates. Keep the independent
         receiver fixture in that IL form so the exact guarded predicates apply. -->
    <Optimize>true</Optimize>
    <EmbedReLogicResource Condition="'$(EmbedReLogicResource)' == ''">true</EmbedReLogicResource>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="JueMingR.Platform"><HintPath>..\..\artifacts\build\Debug\work\bin\JueMingR.Platform\x86\Debug\net472\JueMingR.Platform.dll</HintPath></Reference>
    <Reference Include="JueMingR.Features"><HintPath>..\..\artifacts\build\Debug\work\bin\JueMingR.Features\x86\Debug\net472\JueMingR.Features.dll</HintPath></Reference>
    <Reference Include="JueMingR.Infrastructure"><HintPath>..\..\artifacts\build\Debug\work\bin\JueMingR.Infrastructure\x86\Debug\net472\JueMingR.Infrastructure.dll</HintPath></Reference>
    <Compile Include="..\Notes\*.cs" />
    <Compile Include="..\Items\*.cs" />
    <Compile Include="..\Hotkeys\*.cs" />
    <Compile Include="..\..\src\JueMingR.TerrariaHost\Hotkeys\HotkeyActionIds.cs" />
    <Compile Include="..\..\src\JueMingR.TerrariaHost\Hotkeys\HotkeyPopup.cs" />
    <Compile Include="..\..\src\JueMingR.TerrariaHost\Hotkeys\HotkeyPopupLayout.cs" />
    <Compile Include="..\..\src\JueMingR.TerrariaHost\Hotkeys\HotkeyPopupView.cs" />
    <Compile Include="..\..\src\JueMingR.TerrariaHost\Hotkeys\VanillaHotkeyConflicts.cs" />
    <Compile Include="..\..\src\JueMingR.TerrariaHost\Items\*.cs" Link="Production\Items\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\JueMingR.TerrariaHost\Notes\NotesInput.cs" Link="Production\NotesInput.cs" />
    <Compile Include="..\..\src\JueMingR.TerrariaHost\Notes\NotesPresentation.cs" Link="Production\NotesPresentation.cs" />
    <Compile Include="..\..\src\JueMingR.TerrariaHost\Notes\NotesClipboard.cs" Link="Production\NotesClipboard.cs" />
    <Compile Include="..\..\src\JueMingR.TerrariaHost\Notes\NotesRenderer.cs" Link="Production\NotesRenderer.cs" />
    <Compile Include="..\..\src\JueMingR.TerrariaHost\Notes\NotesCards.cs" Link="Production\NotesCards.cs" />
    <Compile Include="..\..\src\JueMingR.TerrariaHost\Notes\NotesPins.cs" Link="Production\NotesPins.cs" />
    <Compile Include="..\Phase0U\*.cs" />
    <Compile Include="..\..\src\JueMingR.TerrariaHost\Input\*.cs" Link="Production\Input\%(Filename)%(Extension)" />
    <Compile Include="..\Phase0V\SettingsHostChecks.cs" />
    <Compile Include="..\Phase0V\PreferenceFeedbackChecks.cs" />
    <Compile Include="..\..\src\JueMingR.TerrariaHost\F5\F5RowLayout.cs" Link="Production\F5RowLayout.cs" />
    <Compile Include="..\..\src\JueMingR.TerrariaHost\F5\F5ControlRenderer.cs" Link="Production\F5ControlRenderer.cs" />
    <Compile Include="..\..\src\JueMingR.TerrariaHost\F5\F5Layout.cs" Link="Production\F5Layout.cs" />
    <Compile Include="..\..\src\JueMingR.TerrariaHost\F5\F5Interaction.cs" Link="Production\F5Interaction.cs" />
    <Compile Include="..\..\src\JueMingR.TerrariaHost\F5\F5Renderer.cs" Link="Production\F5Renderer.cs" />
    <Compile Include="..\..\src\JueMingR.TerrariaHost\F5\UiSurface.cs" Link="Production\UiSurface.cs" />
    <Compile Include="..\..\src\JueMingR.TerrariaHost\F5\F5IconAtlas.cs" Link="Production\F5IconAtlas.cs" />
    <EmbeddedResource Include="..\..\src\JueMingR.TerrariaHost\F5\Icons\tab-icons.alpha" LogicalName="JueMingR.F5.TabIcons.alpha" />
    <Reference Include="ReLogic">
      <HintPath>..\..\external\TerrariaRefs\ReLogic.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Xna.Framework">
      <HintPath>..\..\external\TerrariaRefs\Microsoft.Xna.Framework.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Xna.Framework.Graphics">
      <HintPath>..\..\external\TerrariaRefs\Microsoft.Xna.Framework.Graphics.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Xna.Framework.Game">
      <HintPath>..\..\external\TerrariaRefs\Microsoft.Xna.Framework.Game.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>..\..\external\Harmony\0Harmony.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <EmbeddedResource Include="..\..\external\TerrariaRefs\ReLogic.dll" Condition="'$(EmbedReLogicResource)' == 'true'">
      <LogicalName>Terraria.Libraries.ReLogic.ReLogic.dll</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
