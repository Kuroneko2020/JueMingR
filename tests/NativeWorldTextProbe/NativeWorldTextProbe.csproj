<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework><PlatformTarget>x86</PlatformTarget><OutputType>Exe</OutputType>
    <AssemblyName>NativeWorldTextProbe</AssemblyName><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Broad probe compiles Debug-only checks; production scopes stage and
         authenticate their own Release runtime assemblies independently. -->
    <JueMingRProbeReferenceConfiguration Condition="'$(JueMingRProbeReferenceConfiguration)' == ''">Debug</JueMingRProbeReferenceConfiguration>
    <JueMingRProbeBuildRoot Condition="'$(JueMingRProbeBuildRoot)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\build\Debug\work\bin</JueMingRProbeBuildRoot>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="JueMingR.Platform"><HintPath>$(JueMingRProbeBuildRoot)\JueMingR.Platform\x86\$(JueMingRProbeReferenceConfiguration)\net472\JueMingR.Platform.dll</HintPath></Reference>
    <Reference Include="JueMingR.Features"><HintPath>$(JueMingRProbeBuildRoot)\JueMingR.Features\x86\$(JueMingRProbeReferenceConfiguration)\net472\JueMingR.Features.dll</HintPath></Reference>
    <Reference Include="JueMingR.Infrastructure"><HintPath>$(JueMingRProbeBuildRoot)\JueMingR.Infrastructure\x86\$(JueMingRProbeReferenceConfiguration)\net472\JueMingR.Infrastructure.dll</HintPath></Reference>
    <Reference Include="Terraria"><HintPath>..\..\external\TerrariaRefs\Terraria.exe</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>..\..\external\Harmony\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ReLogic"><HintPath>..\..\external\TerrariaRefs\ReLogic.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Microsoft.Xna.Framework"><HintPath>..\..\external\TerrariaRefs\Microsoft.Xna.Framework.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Microsoft.Xna.Framework.Graphics"><HintPath>..\..\external\TerrariaRefs\Microsoft.Xna.Framework.Graphics.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Microsoft.Xna.Framework.Game"><HintPath>..\..\external\TerrariaRefs\Microsoft.Xna.Framework.Game.dll</HintPath><Private>false</Private></Reference>
    <Compile Include="..\..\src\JueMingR.TerrariaHost\WorldObjectText\NativeWorldTextLayout.cs" Link="Production\NativeWorldTextLayout.cs" />
    <Compile Include="..\..\src\JueMingR.TerrariaHost\F5\UiTextMetrics.cs" />
    <Compile Include="..\..\src\JueMingR.TerrariaHost\WorldObjectText\WorldObjectHostObservation.cs" />
    <Compile Include="..\..\src\JueMingR.TerrariaHost\WorldObjectText\OpenedContainerObserver.cs" />
    <Compile Include="..\..\src\JueMingR.TerrariaHost\WorldObjectText\WorldObjectTextWorldLayer.cs" />
    <Compile Include="..\..\src\JueMingR.TerrariaHost\WorldObjectText\NativeWorldObjectBounds.cs" />
    <Compile Include="..\..\src\JueMingR.TerrariaHost\World\WorldTileObservation.cs" />
    <Compile Include="..\..\src\JueMingR.TerrariaHost\Rendering\WorldPresentation.cs" />
  </ItemGroup>
</Project>
