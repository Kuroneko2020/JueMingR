<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <OutputType>Library</OutputType>
    <AssemblyName>JueMingR.Infrastructure</AssemblyName>
    <RootNamespace>JueMingR.Infrastructure</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Security" />
    <EmbeddedResource Include="Llm/provider_presets.json" LogicalName="JueMingR.Llm.provider_presets.json" />
    <ProjectReference Include="..\JueMingR.Platform\JueMingR.Platform.csproj" />
  </ItemGroup>
</Project>
